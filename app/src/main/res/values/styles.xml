<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="filterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#444</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

    <style name="AIChipStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

    <style name="Widget.CookingEasy.Chip" parent="Widget.Material3.Chip.Filter">

        <!-- Text -->
        <item name="android:textColor">@color/textPrimary</item>

        <!-- Background -->
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>

        <!-- Stroke -->
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>

        <!-- Shape -->
        <item name="shapeAppearance">@style/Shape.Chip</item>

        <!-- Behavior -->
        <item name="checkedIconVisible">false</item>

    </style>

    <style name="Shape.Chip">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="Shape">
        <item name="android:shape">rectangle</item>
    </style>
</resources>