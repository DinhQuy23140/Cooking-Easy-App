<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_bottom"
    tools:context=".ui.main.fragment.ListChatFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Messenger-style top bar (đồng bộ hero xanh Home / AI Chat) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_hero_header"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtScreenTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/chat_list_title"
                        android:textColor="@android:color/white"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/txtScreenSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/chat_list_subtitle"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCamera"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_circle_glass"
                    android:contentDescription="@string/cd_chat_camera"
                    android:padding="10dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnNewChat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/shape_circle_glass"
                    android:contentDescription="@string/cd_chat_new_message"
                    android:padding="10dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Ô tìm kiếm (Messenger search bar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/shape_chat_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/edtSearchChats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/chat_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text|textCapWords"
                    android:maxLines="1"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs: All / Unread / Groups (Messenger-style filters) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabChatsFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FCF5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:tabIndicatorColor="#2E5E2E"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabRippleColor="#332E5E2E"
            app:tabSelectedTextColor="#2E5E2E"
            app:tabTextColor="#666666">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_tab_all" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_tab_unread" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chat_tab_groups" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Active now (hàng avatar ngang giống Messenger Stories / active friends) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FCF5"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/chat_active_now"
                android:textColor="#2E5E2E"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActiveUsers"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingEnd="8dp"
                tools:itemCount="4"
                tools:listitem="@layout/item_active_user" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A2E5E2E" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshChats"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvChats"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="88dp"
                    tools:listitem="@layout/item_chat_conversation" />

                <LinearLayout
                    android:id="@+id/layoutEmptyChats"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:alpha="0.35"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_send_white"
                        app:tint="#2E5E2E" />

                    <TextView
                        android:id="@+id/txtEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/chat_empty_title"
                        android:textColor="#2E5E2E"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txtEmptySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:text="@string/chat_empty_subtitle"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCompose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/cd_chat_fab_compose"
        app:backgroundTint="#4CAF50"
        app:srcCompat="@drawable/ic_add_white"
        app:tint="@android:color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
