<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_bottom"
    tools:context=".ui.main.fragment.ChatDetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_hero_header"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="48dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/shape_circle_glass"
                android:contentDescription="@string/cd_navigate_back"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@android:color/white" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_avatar_ring"
                    android:contentDescription="@string/cd_chat_row_avatar"
                    android:padding="3dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_person" />

                <View
                    android:id="@+id/viewOnline"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/shape_online_dot" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/chat_detail_name_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/chat_detail_status_online"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_circle_glass"
                android:contentDescription="@string/cd_chat_call"
                android:padding="9dp"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnVideoCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/shape_circle_glass"
                android:contentDescription="@string/cd_chat_video_call"
                android:padding="9dp"
                android:src="@drawable/ic_video"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- Messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            tools:itemCount="6"
            tools:listitem="@layout/item_message_received" />

        <!-- Composer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FCF5"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Messenger-like expandable actions -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnToggleAttachment"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/shape_circle_glass"
                    android:backgroundTint="#5AB453"
                    android:contentDescription="@string/cd_chat_toggle_attachment"
                    android:padding="16dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_add_white"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:id="@+id/layoutAttachmentActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnAttachFile"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/shape_circle_glass"
                        android:backgroundTint="#5AB453"
                        android:contentDescription="@string/cd_chat_attach_file"
                        android:padding="16dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_attach" />

                    <ImageButton
                        android:id="@+id/btnAttachImage"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_circle_glass"
                        android:backgroundTint="#5AB453"
                        android:contentDescription="@string/cd_chat_attach_image"
                        android:padding="16dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_image"
                        app:tint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/btnCapture"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/shape_circle_glass"
                        android:backgroundTint="#5AB453"
                        android:contentDescription="@string/cd_chat_take_photo"
                        android:padding="16dp"
                        android:scaleType="center"
                        android:src="@drawable/ic_camera"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_chat_message_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/edtMessage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/chat_detail_message_hint"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="4"
                        android:minLines="1"
                        android:textColor="#1E1E1E"
                        android:textColorHint="#888888"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_hero_header"
                    android:contentDescription="@string/cd_chat_send_message"
                    android:padding="10dp"
                    android:src="@drawable/ic_send_white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>