<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:rippleColor="#1A2E5E2E"
    app:strokeColor="#332E5E2E"
    app:strokeWidth="0.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true">

        <FrameLayout
            android:id="@+id/frameRecipeImage"
            android:layout_width="0dp"
            android:layout_height="122dp"
            android:clipChildren="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgMeal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_recipe_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_reciper" />

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_hero_bottom" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_favorite_on_photo"
                android:contentDescription="@string/cd_favorite_toggle"
                android:elevation="3dp"
                android:outlineProvider="background"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_heart_outline" />

            <ImageButton
                android:id="@+id/btnYoutube"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/shape_icon_pill_green"
                android:contentDescription="@string/cd_open_youtube"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_youtobe"
                app:tint="#E53935" />
        </FrameLayout>

        <!-- Một cột nội dung: tiêu đề → meta → tác giả, padding đồng bộ -->
        <LinearLayout
            android:id="@+id/contentBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameRecipeImage">

            <TextView
                android:id="@+id/txtMealName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="top|start"
                android:hyphenationFrequency="none"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="#1B1F1C"
                android:textSize="15sp"
                tools:text="Jerk chicken with rice &amp; peas — long title that should ellipsize cleanly" />

            <LinearLayout
                android:id="@+id/rowRecipeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconMeta"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cooking"
                    app:tint="#43A047" />

                <TextView
                    android:id="@+id/txtRecipeMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center_vertical|start"
                    android:maxLines="2"
                    android:minHeight="30dp"
                    android:textColor="#4A5D4A"
                    android:textSize="12sp"
                    tools:text="Chicken • Jamaican · Spicy · Dinner" />
            </LinearLayout>

            <View
                android:id="@+id/dividerMetaFooter"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:background="#12000000" />

            <LinearLayout
                android:id="@+id/layout_inf_chef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgUser"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/shape_avatar_ring"
                    android:contentDescription="@string/cd_user_avatar"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person" />

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/sample_chef_name"
                    android:textColor="#2E5E2E"
                    android:textSize="12sp"
                    tools:text="Chef Admin" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
