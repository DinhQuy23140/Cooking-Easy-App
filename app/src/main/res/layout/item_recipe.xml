<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="#1A2E5E2E"
    app:strokeColor="#262E5E2E"
    app:strokeWidth="0.5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true">

        <!-- Khối ảnh cố định chiều cao: tránh ảnh/overlay tràn xuống che tiêu đề -->
        <FrameLayout
            android:id="@+id/frameRecipeImage"
            android:layout_width="0dp"
            android:layout_height="136dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgMeal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_recipe_photo"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_reciper" />

            <View
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_hero_bottom" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_tag_red"
                android:contentDescription="@string/cd_favorite_toggle"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_favorite" />

            <ImageButton
                android:id="@+id/btnYoutube"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/shape_circle_glass"
                android:contentDescription="@string/cd_open_youtube"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_youtobe" />
        </FrameLayout>

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/txtMealName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:minLines="2"
            android:textColor="#1B1F1C"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/frameRecipeImage"
            tools:text="Jerk chicken with rice &amp; peas" />

        <!-- Hàng: loại / vùng -->
        <ImageView
            android:id="@+id/iconCategoryArea"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cooking"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtMealName"
            app:tint="#5C5C5C" />

        <TextView
            android:id="@+id/txtCategoryArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="#5C5C5C"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/iconCategoryArea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconCategoryArea"
            app:layout_constraintTop_toTopOf="@id/iconCategoryArea"
            tools:text="Jamaican · Chicken" />

        <!-- Hàng: tag -->
        <ImageView
            android:id="@+id/iconTags"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconCategoryArea"
            app:tint="#4D2E5E2E" />

        <TextView
            android:id="@+id/txtTags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:textColor="#4D2E5E2E"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/iconTags"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconTags"
            app:layout_constraintTop_toTopOf="@id/iconTags"
            tools:text="Chilli · Curry" />

        <View
            android:id="@+id/dividerMetaFooter"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:background="#142E5E2E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iconTags" />

        <!-- Footer: tác giả -->
        <LinearLayout
            android:id="@+id/layout_inf_chef"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dividerMetaFooter">

            <ImageView
                android:id="@+id/imgUser"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/shape_avatar_ring"
                android:contentDescription="@string/cd_user_avatar"
                android:padding="2dp"
                android:scaleType="center"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/txtUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/sample_chef_name"
                android:textColor="#444444"
                android:textSize="12sp"
                tools:text="Chef Admin" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
