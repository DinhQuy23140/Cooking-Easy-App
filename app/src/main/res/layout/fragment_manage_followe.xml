<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_bottom"
    android:orientation="vertical"
    tools:context=".ui.main.fragment.ManageFolloweFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/shape_circle_glass"
            android:contentDescription="@string/cd_navigate_back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/nav_profile"
            android:textAllCaps="true"
            android:textColor="#E8F5E9"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#E8EDE8"
        app:strokeWidth="1dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_screen_title"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvManageSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage your social connections"
                    android:textColor="#7A8A79"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/shape_chat_search_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/chat_chip_text_unselected" />

                    <EditText
                        android:id="@+id/edtSearchFollow"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/hint_search_recipes"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/chat_chip_text"
                        android:textColorHint="@color/chat_chip_text_unselected"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearchFollow"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cd_clear_search_history"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="@color/chat_chip_text_unselected" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabFollowers"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/other_user_label_followers"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_person"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="@android:color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabFollowing"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/other_user_label_following"
                        android:textAllCaps="false"
                        android:textColor="#2E5E2E"
                        android:textSize="13sp"
                        app:cornerRadius="20dp"
                        app:icon="@drawable/ic_person"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconTint="#2E5E2E"
                        app:strokeColor="#C5E1A5"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/wrapFollowers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <TableLayout
                        android:id="@+id/tableFollowers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:background="#EEF5EA">
                            <TextView
                                android:padding="10dp"
                                android:text="Name"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                            <TextView
                                android:padding="10dp"
                                android:text="Nickname"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                            <TextView
                                android:padding="10dp"
                                android:text="Action"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                        </TableRow>

                        <TableRow>
                            <TextView android:padding="10dp" android:text="Chef Anna" />
                            <TextView android:padding="10dp" android:text="@chefanna" />
                            <TextView android:padding="10dp" android:text="Message" android:textColor="#2E7D32" />
                        </TableRow>

                        <View android:layout_height="1dp" android:background="#E7EFE3" />

                        <TableRow>
                            <TextView android:padding="10dp" android:text="Quy Nguyen" />
                            <TextView android:padding="10dp" android:text="@quyng" />
                            <TextView android:padding="10dp" android:text="Message" android:textColor="#2E7D32" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/wrapFollowing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fillViewport="true"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <TableLayout
                        android:id="@+id/tableFollowing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1">

                        <TableRow android:background="#EEF5EA">
                            <TextView
                                android:padding="10dp"
                                android:text="Name"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                            <TextView
                                android:padding="10dp"
                                android:text="Nickname"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                            <TextView
                                android:padding="10dp"
                                android:text="Action"
                                android:textColor="#2E5E2E"
                                android:textStyle="bold" />
                        </TableRow>

                        <TableRow>
                            <TextView android:padding="10dp" android:text="Chef Minh" />
                            <TextView android:padding="10dp" android:text="@chefminh" />
                            <TextView android:padding="10dp" android:text="Unfollow" android:textColor="#C62828" />
                        </TableRow>

                        <View android:layout_height="1dp" android:background="#E7EFE3" />

                        <TableRow>
                            <TextView android:padding="10dp" android:text="Bep Nha" />
                            <TextView android:padding="10dp" android:text="@bepnha" />
                            <TextView android:padding="10dp" android:text="Unfollow" android:textColor="#C62828" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>